local function getCar()
    local cars = workspace:FindFirstChild("Cars")
    if not cars then return nil end
    for _, c in ipairs(cars:GetChildren()) do
        if c:IsA("Model") and c:GetAttribute("OwnerUserId") == lp.UserId then return c end
    end
    return nil
end

local function myPlot()
    local g = workspace:FindFirstChild("Game")
    local plots = g and g:FindFirstChild("Lobby") and g.Lobby:FindFirstChild("Plots")
    if not plots then return nil end
    for _, p in ipairs(plots:GetChildren()) do
        if p:IsA("Model") then
            local ownerId = p:GetAttribute("OwnerUserId") or p:GetAttribute("Owner") or p:GetAttribute("UserId")
            if ownerId == lp.UserId or tostring(ownerId) == tostring(lp.UserId) then 
                return p 
            end
        end
    end
    -- Fallback: return plot containing Rolls folder
    for _, p in ipairs(plots:GetChildren()) do
        if p:IsA("Model") and p:FindFirstChild("Rolls") then
            return p
        end
    end
    return nil
end

-- Detect rarity of item in Roll stand by checking Roll.Info.Rarity and ItemPlace item models
local function detectRarityInItemPlace()
    local plot = myPlot()
    if not plot then return nil, nil end
    local rolls = plot:FindFirstChild("Rolls")
    if not rolls then return nil, nil end
    
    for _, rollFolder in ipairs({"RollWeapons", "RollBlocks"}) do
        local rf = rolls:FindFirstChild(rollFolder)
        if rf then
            -- 1. Check Info.Rarity text label
            local info = rf:FindFirstChild("Info") or (rf:FindFirstChild("Roll") and rf.Roll:FindFirstChild("Info"))
            local rarityLabel = info and info:FindFirstChild("Rarity")
            if rarityLabel and rarityLabel:IsA("TextLabel") and rarityLabel.Text ~= "" and rarityLabel.Text ~= "???" then
                local txt = string.lower(rarityLabel.Text)
                for i, rName in ipairs(rarityNames) do
                    if string.find(txt, string.lower(rName)) then
                        return i, rName
                    end
                end
            end

            -- 2. Check ItemPlace item models and GUI/Attributes inside ItemPlace
            local ip = rf:FindFirstChild("ItemPlace")
            if ip then
                for _, child in ipairs(ip:GetChildren()) do
                    -- Check attributes on spawned item model
                    local itemRarity = child:GetAttribute("Rarity") or child:GetAttribute("ItemRarity")
                    if itemRarity then
                        local txt = string.lower(tostring(itemRarity))
                        for i, rName in ipairs(rarityNames) do
                            if string.find(txt, string.lower(rName)) then
                                return i, rName
                            end
                        end
                    end
                    -- Check all descendant TextLabels inside ItemPlace
                    for _, desc in ipairs(child:GetDescendants()) do
                        if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Text ~= "???" then
                            local txt = string.lower(desc.Text)
                            for i, rName in ipairs(rarityNames) do
                                if string.find(txt, string.lower(rName)) then
                                    return i, rName
                                end
                            end
                        end
                    end
                end
            end

            -- 3. Fallback scan of all descendants inside roll stand
            for _, desc in ipairs(rf:GetDescendants()) do
                if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Text ~= "???" and desc.Name ~= "Chance" and desc.Name ~= "Price" and desc.Name ~= "Count" then
                    local txt = string.lower(desc.Text)
                    for i, rName in ipairs(rarityNames) do
                        if string.find(txt, string.lower(rName)) then
                            return i, rName
                        end
                    end
                end
            end
        end
    end
    return nil, nil
end

