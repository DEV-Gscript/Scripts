-- ROLL FARM — fires from any distance by overriding prompt range
task.spawn(function()
    while gui and gui.Parent do
        task.wait(1.5)
        local pauseUntil = _G.rollPauseUntil or 0
        if rollOn and tick() > pauseUntil then
            local plot = myPlot()
            local rolls = plot and plot:FindFirstChild("Rolls")
            if rolls then
                for _, sn in ipairs({"RollBlocks", "RollWeapons"}) do
                    local st = rolls:FindFirstChild(sn)
                    local rp = st and st:FindFirstChild("Roll")
                    local pr = rp and rp:FindFirstChild("ProximityPrompt")
                    if pr then
                        pcall(function()
                            -- bypass distance and line-of-sight checks
                            pr.MaxActivationDistance = math.huge
                            pr.RequiresLineOfSight = false
                            pr.Enabled = true

                            if fireproximityprompt then
                                fireproximityprompt(pr)
                            else
                                pr:InputHoldBegin()
                                task.wait(0.1)
                                pr:InputHoldEnd()
                            end
                        end)
                        rollN = rollN + 1
                    end
                end
            end
        end
    end
end)



table.insert(connections, RunService.PostSimulation:Connect(function()
    applyIgnoreZombies()
    if noclipOn then applyNoclip() end
    if not driveOn then 
        straightDir = nil
        return 
    end

    local car = getCar()
    if not car or not car.PrimaryPart then 
        straightDir = nil
        return 
    end
    local pp = car.PrimaryPart
    local pos = pp.Position
    local vel = pp.AssemblyLinearVelocity
    local speed = Vector3.new(vel.X, 0, vel.Z).Magnitude
    local SPEED = customSpeed
    local now = tick()

    if not serverTop then
        local t = car:GetAttribute("TopSpeed")
        if type(t) == "number" and t > 0 then serverTop = t end
    end

    -- Lock direction when AUTO-DRIVE starts
    if not straightDir then
        local look = pp.CFrame.LookVector
        local hLook = Vector3.new(look.X, 0, look.Z)
        straightDir = hLook.Magnitude > 0.01 and hLook.Unit or Vector3.new(0, 0, -1)
    end

    -- Force zero angular velocity and lock orientation straight ahead to prevent drift/turning
    pp.AssemblyAngularVelocity = Vector3.zero
    pp.CFrame = CFrame.lookAt(pos, pos + straightDir)

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {car, lp.Character}

    -- Determine target velocities along fixed straight direction
    local targetVelX = straightDir.X * SPEED
    local targetVelZ = straightDir.Z * SPEED

    -- Vertical / Ground height adjustment
    local gRay = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -80, 0), rp)
    local targetY = gRay and (gRay.Position.Y + 4) or pos.Y
    local yVel = math.clamp((targetY - pos.Y) * 3, -40, 30)

    -- Apply fixed linear velocity
    pp.AssemblyLinearVelocity = Vector3.new(targetVelX, yVel, targetVelZ)

    if now - lastDbg > 3 then
        lastDbg = now
        local cv = lp:FindFirstChild("CashValue")
        status.Text = string.format("cash: %s | DRIVE\nrolls: %d | buys: %d | vel: %d",
            cv and tostring(cv.Value) or "?", rollN, buyN, math.floor(speed))
    end
end))
