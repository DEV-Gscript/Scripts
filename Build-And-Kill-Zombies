-- Función para Alerta Personalizada con Animación y Barra de Carga
local function customAlert(text, isWarning)
    task.spawn(function()
        if not gui or not gui.Parent then return end
        local card = Instance.new("Frame")
        card.Size = UDim2.new(1, 0, 0, 42)
        card.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
        card.BackgroundTransparency = 1
        card.BorderSizePixel = 0
        card.ClipsDescendants = true
        card.Parent = notifyContainer

        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

        local stroke = Instance.new("UIStroke")
        stroke.Color = isWarning and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 1
        stroke.Thickness = 1
        stroke.Parent = card

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -12, 1, -6)
        label.Position = UDim2.new(0, 6, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = isWarning and Color3.fromRGB(255, 200, 100) or Color3.fromRGB(240, 240, 240)
        label.TextTransparency = 1
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 10
        label.TextWrapped = true
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = card

        -- Barra de Carga
        local progressBar = Instance.new("Frame")
        progressBar.Size = UDim2.new(1, 0, 0, 2)
        progressBar.Position = UDim2.new(0, 0, 1, -2)
        progressBar.BackgroundColor3 = isWarning and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(0, 225, 255)
        progressBar.BackgroundTransparency = 1
        progressBar.BorderSizePixel = 0
        progressBar.Parent = card

        -- Animación de Entrada
        local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
        TweenService:Create(card, tweenInfo, {BackgroundTransparency = 0.15}):Play()
        TweenService:Create(stroke, tweenInfo, {Transparency = 0.8}):Play()
        TweenService:Create(label, tweenInfo, {TextTransparency = 0}):Play()
        TweenService:Create(progressBar, tweenInfo, {BackgroundTransparency = 1}):Play()

        -- Animación de Barra de Carga
        local loadTime = 3.5
        TweenService:Create(progressBar, TweenInfo.new(loadTime, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)}):Play()

        task.wait(loadTime)

        -- Animación de Salida
        local exitTween = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
        TweenService:Create(card, exitTween, {BackgroundTransparency = 1}):Play()
        TweenService:Create(stroke, exitTween, {Transparency = 1}):Play()
        TweenService:Create(label, exitTween, {TextTransparency = 1}):Play()
        TweenService:Create(progressBar, exitTween, {BackgroundTransparency = 1}):Play()

        task.wait(0.3)
        card:Destroy()
    end)
end

