-- Simple polling approach: watch roll stands for the actual dropped item ProximityPrompt

local lastBuyStandState = {} -- Track what we've already processed

task.spawn(function()
    while gui and gui.Parent do
        task.wait(0.3)
        if not autoBuyOn then
            lastBuyStandState = {}
        else
            local plot = myPlot()
            local rolls = plot and plot:FindFirstChild("Rolls")
            if rolls then
                for _, standName in ipairs({"RollWeapons", "RollBlocks"}) do
                    local stand = rolls:FindFirstChild(standName)
                    if stand then
                        -- The item drops physically and has a "BuyPrompt" somewhere inside ItemPlace
                        -- Example Path: ItemPlace.Attachment.BuyPrompt
                        local buyPrompt = nil
                        
                        -- Find any ProximityPrompt in the stand that has "Buy" or "Purchase"
                        for _, desc in ipairs(stand:GetDescendants()) do
                            if desc:IsA("ProximityPrompt") then
                                local action = string.lower(desc.ActionText or "")
                                local name = string.lower(desc.Name)
                                if string.find(action, "buy") or string.find(name, "buy") or string.find(action, "purchase") then
                                    buyPrompt = desc
                                    break
                                end
                            end
                        end
                        
                        if buyPrompt then
                            local itemName = buyPrompt.ObjectText or ""
                            
                            -- When an item is actively rolled, ObjectText changes from "???" to the item name
                            if itemName ~= "" and itemName ~= "???" then
                                
                                -- Prevent processing the exact same roll instance repeatedly
                                -- We track it by the actual ProximityPrompt instance + item name
                                local stateKey = tostring(buyPrompt:GetDebugId(10)) .. "_" .. itemName
                                
                                if lastBuyStandState[standName] ~= stateKey then
                                    lastBuyStandState[standName] = stateKey
                                    
                                    -- Detect rarity
                                    local rIdx, rName = nil, nil
                                    
                                    -- Scan all TextLabels in the stand for a rarity keyword
                                    pcall(function()
                                        for _, desc in ipairs(stand:GetDescendants()) do
                                            if desc:IsA("TextLabel") and desc.Text ~= "" and desc.Text ~= "???" 
                                               and desc.Name ~= "Chance" and desc.Name ~= "Price" and desc.Name ~= "Count" then
                                                local txt = string.lower(desc.Text)
                                                for i, rn in ipairs(rarityNames) do
                                                    if string.find(txt, string.lower(rn)) then
                                                        rIdx, rName = i, rn
                                                        break
                                                    end
                                                end
                                                if rIdx then break end
                                            end
                                        end
                                    end)
                                    
                                    -- Fallback to UI scan
                                    if not rIdx then
                                        rIdx, rName = detectRarityInItemPlace()
                                    end
                                    
                                    print(string.format("[NEO AUTO-BUY] Item dropped in %s | Name: %s | Rarity: %s (%s) | Min: %s",
                                        standName, itemName, tostring(rIdx), tostring(rName), rarityNames[minRarityIdx]))
                                    
                                    local meetsWhitelist = false
                                    if useWhitelist then
                                        local wlText = string.lower(wlBox.Text)
                                        for part in string.gmatch(wlText, "[^,]+") do
                                            part = string.match(part, "^%s*(.-)%s*$") -- trim
                                            if part ~= "" and string.find(string.lower(itemName), part) then
                                                meetsWhitelist = true
                                                break
                                            end
                                        end
                                    end
                                    
                                    if (useWhitelist and meetsWhitelist) or (not useWhitelist and rIdx and rIdx >= minRarityIdx) then
                                        -- BUY IT
                                        _G.rollPauseUntil = tick() + 3.0 -- Pause auto-roll for 3 seconds
                                        
                                        pcall(function()
                                            buyPrompt.MaxActivationDistance = math.huge
                                            buyPrompt.RequiresLineOfSight = false
                                            buyPrompt.Enabled = true
                                            
                                            -- Teleport to the item temporarily to bypass server distance checks
                                            local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                                            local promptPart = buyPrompt.Parent
                                            local oldCFrame = hrp and hrp.CFrame
                                            
                                            if hrp and promptPart and promptPart:IsA("Attachment") then
                                                hrp.CFrame = promptPart.WorldCFrame
                                                task.wait(0.1) -- give server time to register position
                                            end
                                            
                                            if fireproximityprompt then
                                                fireproximityprompt(buyPrompt)
                                            else
                                                buyPrompt:InputHoldBegin()
                                                task.wait(0.15)
                                                buyPrompt:InputHoldEnd()
                                            end
                                            
                                            -- Teleport back
                                            if hrp and oldCFrame then
                                                task.wait(0.2)
                                                hrp.CFrame = oldCFrame
                                            end
                                        end)
                                        buyN = buyN + 1
                                        customAlert("AUTO-BUY: Bought " .. itemName .. " (" .. (rName or "?") .. ")!", false)
                                    else
                                        -- SKIP IT (Do nothing, let the ROLL loop pull the lever again)
                                        customAlert("AUTO-BUY: Skipped " .. itemName .. " (" .. (rName or "?") .. ")", true)
                                    end
                                end
                            else
                                -- If item is ???, the stand is idle, clear the state so next roll can trigger
                                if lastBuyStandState[standName] then
                                    lastBuyStandState[standName] = nil
                                end
                            end
                        else
                            -- No prompt at all = idle
                            if lastBuyStandState[standName] then
                                lastBuyStandState[standName] = nil
                            end
                        end
                    end
                end
            end
        end
    end
end)

local function applyNoclip()
    local car = getCar()
    if car then for _, p in ipairs(car:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
    local ch = lp.Character
    if ch then for _, p in ipairs(ch:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end end
end

-- Lógica Silenciosa para Ignorar Zombis (Siempre Activa)
local function applyIgnoreZombies()
    local folder = workspace:FindFirstChild("Zombies") or workspace:FindFirstChild("Enemies") or workspace:FindFirstChild("NPCs")
    if folder then
        for _, z in ipairs(folder:GetChildren()) do
            for _, p in ipairs(z:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.CanTouch = false
                end
            end
        end
    end
end

