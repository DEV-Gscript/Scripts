        new("TextLabel", {
            Size = UDim2.new(1, -130, 0, 16), Position = UDim2.new(0, 26, 0, 5),
            BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
            TextSize = 12, TextColor3 = C.text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = entry.name, Parent = header,
        })

        new("TextLabel", {
            Size = UDim2.new(1, -130, 0, 14), Position = UDim2.new(0, 26, 0, 21),
            BackgroundTransparency = 1, Font = Enum.Font.Code,
            TextSize = 9, TextColor3 = C.faint,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = (entry.tool and ("[" .. entry.tool.Name .. "] ") or "") .. entry.path,
            Parent = header,
        })

        local countLbl = new("TextLabel", {
            Size = UDim2.new(0, 80, 1, 0), Position = UDim2.new(1, -88, 0, 0),
            BackgroundTransparency = 1, Font = Enum.Font.Code,
            TextSize = 11, TextColor3 = C.amber,
            TextXAlignment = Enum.TextXAlignment.Right,
            Text = "x0", Parent = header,
        })

        local argsFrame = new("Frame", {
            Size = UDim2.new(1, -16, 0, 0), Position = UDim2.new(0, 8, 0, 42),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Visible = false, Parent = row,
        }, { new("UIListLayout", { Padding = UDim.new(0, 2) }) })

        local rowRec = {
            frame = row, header = header, argsFrame = argsFrame,
            countLbl = countLbl, expanded = false,
            entry = entry, argRows = {},
        }

        header.MouseButton1Click:Connect(function()
            rowRec.expanded = not rowRec.expanded
            argsFrame.Visible = rowRec.expanded
            row.BackgroundColor3 = rowRec.expanded and C.panelHi or C.panel
            header.BackgroundColor3 = row.BackgroundColor3
        end)

        UI.rows[entry.path] = rowRec
        return rowRec
    end

    local function refreshArgs(rowRec)
        local entry = rowRec.entry
        for _, c in ipairs(rowRec.argsFrame:GetChildren()) do
            if not c:IsA("UIListLayout") then c:Destroy() end
        end
        local sigs = {}
        for sig, b in pairs(entry.args) do sigs[#sigs + 1] = { sig = sig, b = b } end
        table.sort(sigs, function(a, b) return a.b.count > b.b.count end)
        for _, s in ipairs(sigs) do
            local typStr = #s.b.types > 0
                and ("(" .. table.concat(s.b.types, ", ") .. ")")
                or "(no args)"
            new("TextLabel", {
                Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
                Font = Enum.Font.Code, TextSize = 10, TextColor3 = C.dim,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = ("  %s  x%d"):format(typStr, s.b.count),
                Parent = rowRec.argsFrame,
            })
            if #s.b.sample > 0 then
                new("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
                    Font = Enum.Font.Code, TextSize = 10, TextColor3 = C.faint,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Text = "      " .. table.concat(s.b.sample, ", "),
                    Parent = rowRec.argsFrame,
                })
            end
        end
        new("Frame", {
            Size = UDim2.new(1, 0, 0, 8), BackgroundTransparency = 1,
            Parent = rowRec.argsFrame,
        })
    end

    REC.onNew = function(entry)
        local r = makeRow(entry)
        refreshArgs(r)
    end

    UI.search:GetPropertyChangedSignal("Text"):Connect(function()
        local q = UI.search.Text:lower()
        for path, r in pairs(UI.rows) do
            if q == "" then
                r.frame.Visible = true
            else
                r.frame.Visible = path:lower():find(q, 1, true) ~= nil
                    or r.entry.name:lower():find(q, 1, true) ~= nil
                    or (r.entry.tool and r.entry.tool.Name:lower():find(q, 1, true) ~= nil)
            end
        end
    end)

    -- render tick ---------------------------------------------------------
    task.spawn(function()
        while not REC.dead and UI.gui do
            task.wait(0.2)
            for path in pairs(REC.dirty) do
                local r = UI.rows[path]
                local e = REC.entries[path]
                if r and e then
                    r.countLbl.Text = "x" .. e.count
                    if r.expanded then refreshArgs(r) end
                end
            end
            REC.dirty = {}
            UI.statLbl.Text = ("%d remotes · %d calls"):format(#REC.order, REC.total)

            -- keep status strip honest
            if REC.hookOK then
                UI.statusDot.BackgroundColor3 = C.green
                UI.statusLbl.Text = ("hook installed · listening · %s"):format(
                    REC.paused and "paused" or "live")
            else
                UI.statusDot.BackgroundColor3 = C.red
                UI.statusLbl.Text = ("hook FAILED · %s"):format(tostring(REC.hookErr or "?"))
            end
        end
    end)

    print("[REC2] UI built OK")
    return true
end

--==============================================================================
-- BOOT
--==============================================================================

print("[REC2] attempting hook...")
tryHook()

print("[REC2] attempting UI...")
local ok, err = pcall(buildUI)
if not ok then
    warn("[REC2] UI build error: " .. tostring(err))
end

if REC.hookOK then
    print("[REC2] READY — hook live")
else
    warn("[REC2] READY, but hook not installed: " .. tostring(REC.hookErr))
end

--==============================================================================
-- API
--==============================================================================

if getgenv then
    getgenv().REC = {
        loaded   = true,
        entries  = function() return REC.entries end,
        order    = function() return REC.order end,
        total    = function() return REC.total end,
        hookOK   = function() return REC.hookOK end,
        hookErr  = function() return REC.hookErr end,
        retry    = tryHook,
        pause    = function() REC.paused = true end,
        resume   = function() REC.paused = false end,
        clear    = function()
            REC.entries = {}; REC.order = {}; REC.total = 0; REC.dirty = {}
            if UI.rows then
                for _, r in pairs(UI.rows) do pcall(function() r.frame:Destroy() end) end
                UI.rows = {}
            end
            if UI.emptyLbl then UI.emptyLbl.Visible = true end
        end,
        toolsOnly = function(on)
            CFG.ToolsOnly = on and true or false
            return CFG.ToolsOnly
        end,
        export   = function()
            local s = buildExportString()
            if env.setclipboard then env.setclipboard(s) end
            return s
        end,
        printTable = function()
            print("\n--[ Remote Recorder export ]--")
            print(buildExportString())
            print("--[ end ]--\n")
        end,
        unload   = function()
            REC.dead = true
            if UI.gui then pcall(function() UI.gui:Destroy() end) end
            if getgenv then getgenv().REC = nil end
        end,
    }
end

return getgenv and getgenv().REC
