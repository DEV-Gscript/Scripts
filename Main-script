--==============================================================================
-- HELPERS
--==============================================================================

local function findTool(inst)
    local cur = inst
    while cur do
        if cur:IsA("Tool") then return cur end
        cur = cur.Parent
    end
    return nil
end

local function describe(v)
    local t = typeof(v)
    if t == "Instance" then
        return ("%s(%s)"):format(v.ClassName, v.Name)
    elseif t == "Vector3" then
        return ("V3(%.1f,%.1f,%.1f)"):format(v.X, v.Y, v.Z)
    elseif t == "Vector2" then
        return ("V2(%.1f,%.1f)"):format(v.X, v.Y)
    elseif t == "CFrame" then
        local p = v.Position
        return ("CF(%.1f,%.1f,%.1f)"):format(p.X, p.Y, p.Z)
    elseif t == "Color3" then
        return ("C3(%.2f,%.2f,%.2f)"):format(v.R, v.G, v.B)
    elseif t == "string" then
        if #v > 48 then v = v:sub(1, 48) .. "..." end
        return ("%q"):format(v)
    elseif t == "table" then
        local n = 0
        for _ in pairs(v) do n = n + 1 end
        return ("{table %d}"):format(n)
    elseif t == "nil" then
        return "nil"
    else
        return tostring(v)
    end
end

local function argSig(args)
    if #args == 0 then return "(no args)" end
    local types = {}
    for i = 1, math.min(#args, CFG.MaxArgs) do
        types[i] = typeof(args[i])
    end
    return table.concat(types, "|")
end

local function argSamples(args)
    local out = {}
    for i = 1, math.min(#args, CFG.MaxArgs) do
        out[i] = describe(args[i])
    end
    return out
end

local function clockStr()
    return os.date("%H:%M:%S")
end

--==============================================================================
-- RECORD
--==============================================================================

local function record(remote, method, args)
    if REC.paused or REC.dead then return end
    local ok, err = pcall(function()
        if not (remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction")
                or remote:IsA("UnreliableRemoteEvent")) then
            return
        end

        local tool = findTool(remote)
        if CFG.ToolsOnly and not tool then return end

        local path = remote:GetFullName()
        local entry = REC.entries[path]
        local isNew = false

        if not entry then
            entry = {
                remote    = remote,
                path      = path,
                name      = remote.Name,
                class     = remote.ClassName,
                method    = method,
                tool      = tool,
                count     = 0,
                args      = {},
                firstSeen = os.clock(),
                lastSeen  = os.clock(),
            }
            REC.entries[path] = entry
            REC.order[#REC.order + 1] = path
            isNew = true
        end

        entry.count    = entry.count + 1
        entry.lastSeen = os.clock()
        entry.method   = method
        if not entry.tool and tool then entry.tool = tool end

        local sig = argSig(args)
        local bucket = entry.args[sig]
        if not bucket then
            local t = {}
            for i = 1, math.min(#args, CFG.MaxArgs) do t[i] = typeof(args[i]) end
            bucket = { types = t, sample = argSamples(args), count = 0 }
            entry.args[sig] = bucket
        end
        bucket.count = bucket.count + 1
        REC.total    = REC.total + 1
        REC.dirty[path] = true

        if isNew and REC.onNew then pcall(REC.onNew, entry) end

        if CFG.PrintConsole then
            local argStr = table.concat(argSamples(args), ", ")
            print(("[%s] %s  %s:%s(%s)"):format(
                clockStr(),
                tool and ("[" .. tool.Name .. "]") or "[—]",
                path, method, argStr))
        end
    end)
    if not ok then
        warn("[REC2] record error: " .. tostring(err))
    end
end

--==============================================================================
-- HOOK
--==============================================================================

local function tryHook()
    if REC.hookOK then return true end

    if not env.hookmetamethod or not env.getnamecall then
        REC.hookErr = "hookmetamethod/getnamecallmethod missing"
        warn("[REC2] " .. REC.hookErr)
        return false
    end

    local ok, err = pcall(function()
        local old
        local hookFn = function(self, ...)
            local m = env.getnamecall()
            if m == "FireServer" or m == "InvokeServer" then
                local pack = table.pack(...)
                record(self, m, pack)
            end
            return old(self, ...)
        end
        if env.newcclosure then
            hookFn = env.newcclosure(hookFn)
        end
        old = env.hookmetamethod(game, "__namecall", hookFn)
    end)

    if not ok then
        REC.hookErr = tostring(err)
        warn("[REC2] hook install failed: " .. REC.hookErr)
        return false
    end

    REC.hookOK  = true
    REC.hookErr = nil
    print("[REC2] __namecall hook installed OK")
    return true
end

