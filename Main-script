local function new(class, props, children)
    local inst = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else inst[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    if parent then inst.Parent = parent end
    return inst
end

local function hoverify(btn, base, hi)
    btn.MouseEnter:Connect(function()
        Tween:Create(btn, TweenInfo.new(0.14), { BackgroundColor3 = hi }):Play()
    end)
    btn.MouseLeave:Connect(function()
        Tween:Create(btn, TweenInfo.new(0.14), { BackgroundColor3 = base }):Play()
    end)
end

local function mount(gui)
    local tries = {}
    if gethui then tries[#tries + 1] = { "gethui", function() return gethui() end } end
    tries[#tries + 1] = { "CoreGui",   function() return game:GetService("CoreGui") end }
    tries[#tries + 1] = { "PlayerGui", function() return LP:FindFirstChildOfClass("PlayerGui") end }
    for _, t in ipairs(tries) do
        local ok, parent = pcall(t[2])
        if ok and parent then
            local okp = pcall(function() gui.Parent = parent end)
            if okp and gui.Parent == parent then
                print(("[REC2] mounted to %s"):format(t[1]))
                return t[1]
            end
        end
    end
    return nil
end

--==============================================================================
-- EXPORT STRING
--==============================================================================

local function buildExportString()
    local lines = {}
    lines[#lines + 1] = "return {"
    for _, path in ipairs(REC.order) do
        local e = REC.entries[path]
        if e then
            lines[#lines + 1] = ("    [%q] = {"):format(path)
            lines[#lines + 1] = ("        name    = %q,"):format(e.name)
            lines[#lines + 1] = ("        class   = %q,"):format(e.class)
            lines[#lines + 1] = ("        method  = %q,"):format(e.method)
            lines[#lines + 1] = ("        tool    = %s,"):format(e.tool and ("%q"):format(e.tool.Name) or "nil")
            lines[#lines + 1] = ("        calls   = %d,"):format(e.count)
            lines[#lines + 1] =  "        args    = {"
            local sigs = {}
            for sig, b in pairs(e.args) do sigs[#sigs + 1] = { sig = sig, b = b } end
            table.sort(sigs, function(a, b) return a.b.count > b.b.count end)
            for _, s in ipairs(sigs) do
                local tl, sl = {}, {}
                for i, t in ipairs(s.b.types)  do tl[i] = ("%q"):format(t) end
                for i, v in ipairs(s.b.sample) do sl[i] = ("%q"):format(v) end
                lines[#lines + 1] = ("            { types = {%s}, sample = {%s}, calls = %d },")
                    :format(table.concat(tl, ", "), table.concat(sl, ", "), s.b.count)
            end
            lines[#lines + 1] =  "        },"
            lines[#lines + 1] =  "    },"
        end
    end
    lines[#lines + 1] = "}"
    return table.concat(lines, "\n")
end

